// The Wonderpark app icon: the compass-star emblem (our own art,
// assets/icon/; not the Android tile in png-named/). The lowest-numbered
// icon is the one Explorer, the taskbar and shortcuts show.
1 ICON "../../assets/icon/wonderpark.ico"

// The launcher's fonts (SIL Open Font License; see fonts/*-OFL.txt), built
// into the executable so it needs nothing beside it.
101 RCDATA "fonts/Fredoka.ttf"
102 RCDATA "fonts/Nunito.ttf"
